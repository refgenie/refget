{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint:styles && tsc -b && vite build",
    "type-check": "tsc -b --noEmit",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:styles": "node scripts/web-style-guard.mjs",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@databio/gtars": "^0.9.2",
    "d3": "^7.9.0",
    "lz-string": "^1.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.3",
    "vega-embed": "^7.2.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-alias": "^6.0.0",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
